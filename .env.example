# Copy to .env and replace both required secrets before using Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
RELOAD_ADMIN_KEY=replace-with-a-long-random-secret

# Optional: set ANSWER_MODE=llm only after installing requirements-llm.txt.
ANSWER_MODE=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# tfidf is the default and measured baseline. semantic/hybrid need requirements-ml.txt.
RETRIEVER_BACKEND=tfidf
